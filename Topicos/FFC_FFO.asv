%% =========================================================
%  ANALISIS DE CONTROLABILIDAD, OBSERVABILIDAD
%  FORMAS CANONICAS (ORDEN ARBITRARIO n)
% =========================================================

clc; clear;
syms s k ki ki2 ki3

%% ===== DEFINICION DEL SISTEMA =====

A = [-9e-5 6e-5 0;
     9e-5 -3.26;
     0 0 0 1;
     0 20 -400 -20]

B = [0; 0.2; 0; 0]
C = [0 0 1 0]
D = 0

E = [0; 0; 0; 0]
F = 0

n = size(A,1)   % Orden del sistema

%% =========================================================
%  MATRIZ DE CONTROLABILIDAD
% =========================================================
controla = sym(zeros(n,n)); 

for a = 1:n
    controla(:,a) = A^(a-1)*B;
end

Smat = vpa(controla, 4)

det_controla = vpa(det(controla), 4)

%% =========================================================
%  POLINOMIO CARACTERISTICO
% =========================================================
FNC = vpa(det(s*eye(n) - A))
coef = coeffs(FNC, s, 'All');  % [a0 a1 ... a_{n-1} 1]

% Obtener función de transferencia
[num, den] = ss2tf(A, B, C, D);

% Asegurar formato correcto
num = num(1,:);
num = [zeros(1, length(den)-length(num)) num];  % igualar longitud
den = den(:)';

funcion = tf(num, den);

% Mostrar automáticamente en consola
disp('Función de Transferencia:')
funcion 

%% =========================================================
%  MATRIZ M (FORMA CANONICA CONTROLABLE)
% =========================================================
M = sym(zeros(n));

for i = 1:n
    for j = 1:n
        idx = n + 2 - i - j;
        if idx >= 1 && idx <= length(coef)
            M(i,j) = coef(idx);
        else
            M(i,j) = 0;
        end
    end
end

M = vpa(M, 4)

%% =========================================================
%  TRANSFORMACION A FORMA CANONICA CONTROLABLE
% =========================================================
T = vpa(controla * M, 4)

Afcc = double(vpa(inv(T)*A*T, 4))
Bfcc = double(vpa(inv(T)*B, 4))
Cfcc = double(vpa(C*T, 4))
Dfcc = double(D)

Efcc = double(vpa(inv(T)*E, 4))
Ffcc = double(F)

%% =========================================================
%  MATRIZ DE OBSERVABILIDAD
% =========================================================
observa = sym(zeros(n,n));

for a = 1:n
    observa(a,:) = flip(C)*A^(a-1);
end

Omat = vpa(observa, 4) 

det_observa = vpa(det(observa), 4)

%% =========================================================
%  TRANSFORMACION A FORMA CANONICA OBSERVABLE
% =========================================================
Q = vpa(inv(M*observa), 4)
if(det_observa~=0)
    Afco = double(vpa(inv(Q)*A*Q, 4))
    Bfco = double(vpa(inv(Q)*B, 4))
    Cfco = double(vpa(C*Q, 4))
    Dfco = double(D)

    Efco = double(vpa(inv(Q)*E, 4))
    Ffco = double(F)
end
%% Matrices Empaquetadas y Asterisco
% Matriz a usar: (1)Estandar, (2)FCC, (3)FCO
matriz = 1;
switch matriz
    case 1
        Acon = A;
        Bcon = B;
        Ccon = C;
        Dcon = D;
        Econ = E;
        Fcon = F;
    case 2
        Acon = Afcc;
        Bcon = Bfcc;
        Ccon = Cfcc;
        Dcon = Dfcc;
        Econ = Efcc;
        Fcon = Ffcc;
    case 3
        Acon = Afco;
        Bcon = Bfco;
        Ccon = Cfco;
        Dcon = Dfco;
        Econ = Efco;
        Fcon = Ffco;
end

k = sym('k', [1 n]);

% Entradas: (1)Escalon, (2)Rampa, (3)Parabola
entrada = 1;

switch entrada
    case 1
        Aast = [Acon-Bcon*k Bcon*ki;
                -Ccon 0];
        Aast = vpa(Aast)
        Aemp = [Acon zeros(n,1);
                -Ccon 0];
        Aemp = double(vpa(Aemp))
        Bemp = [Bcon; 0];
        Bemp = double(vpa(Bemp))
    case 2
        Aast = [Acon-Bcon*k Bcon*ki2 Bcon*ki;
                zeros(1,n) 0 1;
                -Ccon 0 0];
        Aast= vpa(Aast)
        Aemp = [Acon zeros(n,1) zeros(n,1);
                zeros(1,n) 0 1;
                -Ccon 0 0];
        Aemp = double(vpa(Aemp))
        Bemp = [Bcon; 0; 0];
        Bemp = double(vpa(Bemp))
    case 3
        Aast = [Acon-Bcon*k Bcon*ki3 Bcon*ki2 Bcon*ki;
                zeros(1,n) 0 1 0;
                zeros(1,n) 0 0 1;
                -Ccon 0 0 0];
        Aast = vpa(Aast)
        Aemp = [Acon zeros(n,1) zeros(n,1) zeros(n,1);
                zeros(1,n) 0 1 0;
                zeros(1,n) 0 0 1;
                -Ccon 0 0 0];
        Aemp = double(vpa(Aemp))
        Bemp = [Bcon; 0; 0; 0];
        Bemp = double(vpa(Bemp))
end

nast = size(Aast,1);   % tamaño de la matriz Aast
nemp = size(Aemp,1);   % tamaño de la matriz Aemp

zd = 0.7
tsd = 2.7
wnd = 4/(zd*tsd)
%% Asignacion de Polos
KAP = vpa(det(s*eye(nast) - Aast));
KAP = collect(KAP, s)
polDesAP = vpa(expand((s^2 + 2*zd*wnd*s + wnd^2)*(s + 10*zd*wnd)^(nemp-2)))
%% Matriz de transformacion
Semp = sym(zeros(nemp,nemp)); 
for a = 1:nemp
    Semp(:,a) = Aemp^(a-1)*Bemp;
end
Semp = vpa(Semp, 4)

den = vpa(det(s*eye(nemp) - Aemp))

coefemp = coeffs(den, s, 'All')  % [a0 a1 ... a_{n-1} 1]

Memp = sym(zeros(nemp));
for i = 1:nemp
    for j = 1:nemp
        idx = nemp + 2 - i - j;
        if idx >= 1 && idx <= length(coefemp)
            Memp(i,j) = coefemp(idx);
        else
            Memp(i,j) = 0;
        end
    end
end
Memp = vpa(Memp, 4)

Temp = Semp*Memp

polDes = (s^2 + 2*zd*wnd*s + wnd^2)*(s + 10*zd*wnd)^(nemp-2);
polDes = vpa(expand(polDes))

coefpolD = coeffs(polDes, s, 'All');  % [a0 a1 ... a_{n-1} 1]

K = (flip(coefpolD(2:end) - coefemp(2:end)))*inv(Temp);

% Separar:
% coeficientes desde a2 hasta a1
KMT = double(K(1:end-1))

% último coeficiente (término constante)
KiMT = double(K(end))

wndObs = 4/(zd*(tsd/10));

% Observador
polDObs = vpa(expand((s^2 + 2*zd*wndObs + wndObs^2)*(s + 10*zd*wndObs)^(n-2)))
coefpolDObs = coeffs(polDObs, s, 'All');  % [a0 a1 ... a_{n-1} 1]

pre = flip(coefpolDObs(2:end) - coef(2:end))
LMT = double(Q * pre.')
%% Ackerman
polDes = (s^2 + 2*zd*wnd*s + wnd^2)*(s + 10*zd*wnd)^(nemp-2);
polDes = vpa(expand(polDes))
coefpolD = double(coeffs(polDes, s, 'All'));  % [a0 a1 ... a_{n-1} 1]

PhiAemp = polyvalm(coefpolD, Aemp)
KackT = [zeros(1,nemp-1) 1]*inv(Semp)*PhiAemp

% Separar:
% coeficientes desde a2 hasta a1
Kack = double(KackT(1:end-1))

% último coeficiente (término constante)
KiAck = double(KackT(end))