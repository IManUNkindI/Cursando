%% ======================PID (Discrete)===============================
clc; clear all; close all; syms z r0 r1 r2 r3 r4 r5;
numc = 19.93;
denc = [1, 7.634, 1.805e-9];
tfc = tf(numc,denc);

Tm = 0.1;
tfd = c2d(tfc,Tm);
numd = tfc.Numerator(1,1);
dend = tfc.Denominator(1,1);

tsd = 1; zd = 0.7; 
wnd = 4/(tsd*zd);

P1 = (-2*exp(1)^(-zd*wnd*Tm))*cos(wnd*Tm*sqrt(1-(zd^2)));
P2 = exp(1)^(-2*zd*Tm*wnd);
n = 4;
PDD = (z^2 + (P1)*z + P2) * (z - 0.1)^n;
PDD_org = vpa(expand(PDD),4)

const = (0.07848*z + 0.06091)*(r0*z^5 + r1*z^4 + r2*z^3 + r3*z^2 + r4) + (z^2 - 1.466*z + 0.4661)*(z-1)^3;
const_org = vpa(collect(const,z),4)


eq = expand(PDD_org - const_org);
[c,t] = coeffs(eq,z);
S = solve(c == 0,[r0 r1 r2 r3 r4 r5])
