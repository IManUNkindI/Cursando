*DIM,_loadvari43,TABLE,2,1,1,TIME,
! Time values
_loadvari43(1,0,1) = 0.
_loadvari43(2,0,1) = 1.
! Load values
_loadvari43(1,1,1) = 22.
_loadvari43(2,1,1) = 450.

